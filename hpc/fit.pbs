#!/bin/bash
#PBS -N ionff_fit
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -l walltime=06:00:00
#PBS -j oe
# Fit both ways, leave-one-solvent-out test, cluster many-body test. Needs the merged reference files.
# Submit: qsub -v STORAGE=$STORAGE,IONFF_REPO=$PWD hpc/fit.pbs

source "${IONFF_REPO:-$PBS_O_WORKDIR}/hpc/common.sh"
# Merge the per-task reference files written by the array jobs
cat data/reference/sapt0_scan_*.jsonl > data/reference/sapt0_scan.jsonl
cat data/reference/sapt0_clusters_*.jsonl > data/reference/sapt0_clusters.jsonl
python scripts/run_fit.py
python scripts/run_cluster_test.py
